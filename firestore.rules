rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidLeadId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLeadCreate(data) {
      return data.keys().hasAll(['naam', 'phoneNumber', 'city', 'createdAt'])
        && data.keys().hasOnly(['naam', 'phoneNumber', 'city', 'source', 'userId', 'createdAt', 'aiStatus'])
        && data.naam is string && data.naam.size() >= 1 && data.naam.size() <= 100
        && data.phoneNumber is string && data.phoneNumber.size() >= 5 && data.phoneNumber.size() <= 30
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 80
        && (!('source' in data) || (data.source is string && data.source.size() <= 40))
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128 && (request.auth == null ? data.userId == 'guest' : data.userId == request.auth.uid)))
        && (!('aiStatus' in data) || data.aiStatus == 'pending')
        && data.createdAt == request.time;
    }

    function isValidLeadAiUpdate() {
      let data = request.resource.data;
      return data.keys().hasOnly(['naam', 'phoneNumber', 'city', 'source', 'userId', 'createdAt', 'aiStatus', 'leadLabel', 'whatsappReply', 'aiModel', 'aiError', 'aiProcessedAt'])
        && data.diff(resource.data).affectedKeys().hasOnly(['aiStatus', 'leadLabel', 'whatsappReply', 'aiModel', 'aiError', 'aiProcessedAt'])
        && data.aiStatus in ['pending', 'completed', 'error']
        && (!('leadLabel' in data) || data.leadLabel in ['HOT', 'COLD'])
        && (!('whatsappReply' in data) || (data.whatsappReply is string && data.whatsappReply.size() <= 600))
        && (!('aiModel' in data) || (data.aiModel is string && data.aiModel.size() <= 80))
        && (!('aiError' in data) || (data.aiError is string && data.aiError.size() <= 300))
        && data.aiProcessedAt == request.time;
    }

    function isLeadsAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'nisarrsna@gmail.com';
    }

    function isValidToolConfig(data) {
      return data.keys().hasAll(['disabledTools'])
        && data.keys().hasOnly(['disabledTools', 'updatedBy', 'updatedAt'])
        && data.disabledTools is list
        && data.disabledTools.size() <= 50
        && (data.disabledTools.size() == 0 || data.disabledTools[0] is string)
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    function isValidChatSession(data) {
      return data.keys().hasAll(['title', 'userId', 'messages', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'userId', 'projectId', 'messages', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && (!('projectId' in data) || (data.projectId is string && data.projectId.size() <= 128))
        && data.messages is list && data.messages.size() <= 200
        && (data.messages.size() == 0 || data.messages[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudioUserCreate(userId, data) {
      return data.keys().hasAll(['uid', 'plan', 'credits', 'dailyFreeRemaining', 'dailyLimit', 'lastResetDate'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'plan', 'credits', 'dailyFreeRemaining', 'dailyLimit', 'lastResetDate', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && data.plan == 'FREE'
        && data.credits is number && data.credits >= 0 && data.credits <= 10
        && data.dailyFreeRemaining is number && data.dailyFreeRemaining >= 0 && data.dailyFreeRemaining <= 10
        && data.dailyLimit is number && data.dailyLimit == 10
        && data.lastResetDate is string && data.lastResetDate.size() == 10;
    }

    function isValidStudioUserSelfUpdate(userId) {
      let data = request.resource.data;
      return data.uid == userId
        && data.plan == resource.data.plan
        && data.credits is number && data.credits >= 0
        && (
          data.credits <= resource.data.credits
          || (data.lastResetDate != resource.data.lastResetDate && data.credits <= 10)
        )
        && data.dailyFreeRemaining is number && data.dailyFreeRemaining >= 0 && data.dailyFreeRemaining <= 10
        && data.lastResetDate is string && data.lastResetDate.size() == 10;
    }

    function isValidCollectedResearch(data) {
      return data.keys().hasAll(['userId', 'query', 'title', 'summary', 'createdAt'])
        && data.keys().hasOnly(['userId', 'query', 'title', 'category', 'summary', 'keyMetrics', 'sourceUrl', 'sourceTitle', 'sources', 'modelUsed', 'createdAt'])
        && data.userId == request.auth.uid
        && data.query is string && data.query.size() >= 1 && data.query.size() <= 500
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 220
        && data.summary is string && data.summary.size() <= 2000
        && (!('category' in data) || (data.category is string && data.category.size() <= 80))
        && (!('keyMetrics' in data) || (data.keyMetrics is string && data.keyMetrics.size() <= 320))
        && (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 600))
        && (!('sourceTitle' in data) || (data.sourceTitle is string && data.sourceTitle.size() <= 220))
        && (!('sources' in data) || (data.sources is list && data.sources.size() <= 10))
        && (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() <= 80))
        && data.createdAt == request.time;
    }

    function isValidToolboxRun(data) {
      return data.keys().hasAll(['userId', 'toolMode', 'providerUsed', 'modelUsed', 'createdAt'])
        && data.keys().hasOnly(['userId', 'toolMode', 'toolLabel', 'providerUsed', 'modelUsed', 'fallbackUsed', 'promptPreview', 'outputPreview', 'promptLength', 'executionTimeMs', 'createdAt'])
        && data.userId == request.auth.uid
        && data.toolMode is string && data.toolMode.size() >= 1 && data.toolMode.size() <= 60
        && data.providerUsed in ['gemini', 'claude']
        && data.modelUsed is string && data.modelUsed.size() >= 1 && data.modelUsed.size() <= 100
        && (!('promptPreview' in data) || (data.promptPreview is string && data.promptPreview.size() <= 600))
        && (!('outputPreview' in data) || (data.outputPreview is string && data.outputPreview.size() <= 4000))
        && (!('promptLength' in data) || (data.promptLength is number && data.promptLength >= 0 && data.promptLength <= 10000))
        && (!('executionTimeMs' in data) || (data.executionTimeMs is number && data.executionTimeMs >= 0))
        && data.createdAt == request.time;
    }

    function isValidLocalPaymentCreate(data) {
      return data.keys().hasAll(['userId', 'method', 'accountNumber', 'plan', 'amountPkr', 'credits', 'tid', 'senderNumber', 'status', 'createdAt'])
        && data.keys().hasOnly(['userId', 'userEmail', 'method', 'accountNumber', 'plan', 'amountPkr', 'credits', 'tid', 'senderNumber', 'status', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.method in ['JazzCash', 'Easypaisa']
        && data.accountNumber == '0323-5052148'
        && data.plan in ['STARTER', 'PRO']
        && ((data.plan == 'STARTER' && data.amountPkr == 499 && data.credits == 100) || (data.plan == 'PRO' && data.amountPkr == 1499 && data.credits == 500))
        && data.tid is string && data.tid.size() >= 4 && data.tid.size() <= 80
        && data.senderNumber is string && data.senderNumber.size() >= 5 && data.senderNumber.size() <= 30
        && data.status == 'PENDING_VERIFICATION'
        && data.createdAt == request.time;
    }

    // Projects Rules
    match /projects/{projectId} {
      allow create: if !isAuthenticated() || request.resource.data.tenantId == request.auth.uid;
      allow read, update, delete: if !isAuthenticated() || resource.data.tenantId == request.auth.uid;
    }

    // Jobs Rules
    match /jobs/{jobId} {
      allow create: if !isAuthenticated() || request.resource.data.tenantId == request.auth.uid;
      allow read, update, delete: if !isAuthenticated() || resource.data.tenantId == request.auth.uid;
    }

    // Products Rules
    match /products/{productId} {
      allow create: if !isAuthenticated() || request.resource.data.tenantId == request.auth.uid;
      allow read, update, delete: if !isAuthenticated() || resource.data.tenantId == request.auth.uid;
    }

    // Memory Rules
    match /memory/{memoryId} {
      allow create: if !isAuthenticated() || request.resource.data.tenantId == request.auth.uid;
      allow read, update, delete: if !isAuthenticated() || resource.data.tenantId == request.auth.uid;
    }

    // Social Posts Rules
    match /social_posts/{postId} {
      allow create: if !isAuthenticated() || request.resource.data.tenantId == request.auth.uid;
      allow read, update, delete: if !isAuthenticated() || resource.data.tenantId == request.auth.uid;
    }

    // Agents Rules
    match /agents/{agentId} {
      allow create: if !isAuthenticated() || request.resource.data.tenantId == request.auth.uid;
      allow read, update, delete: if !isAuthenticated() || resource.data.tenantId == request.auth.uid;
    }

    // Pages Rules (Website Builder)
    match /pages/{pageId} {
      allow create: if !isAuthenticated() || request.resource.data.tenantId == request.auth.uid;
      allow read, update, delete: if !isAuthenticated() || resource.data.tenantId == request.auth.uid;
    }

    // Activities Rules (Recent Activity logs)
    match /activities/{activityId} {
      allow create: if !isAuthenticated() || request.resource.data.tenantId == request.auth.uid;
      allow read, update, delete: if !isAuthenticated() || resource.data.tenantId == request.auth.uid;
    }

    // User Preferences Rules (Favorite AI tools, workspace layout settings)
    match /user_preferences/{userId} {
      allow create, read, update, delete: if !isAuthenticated() || request.auth.uid == userId || resource.data.tenantId == request.auth.uid;
    }

    // Super AI Toolbox: User Credits & Transactions
    match /user_credits/{userId} {
      allow create, read, update, delete: if true;

      match /transactions/{txId} {
        allow create, read, update, delete: if true;
      }
    }

    // Super AI Toolbox: Generation History
    match /ai_history/{historyId} {
      allow create, read, update, delete: if true;
    }

    // Vibe Accounts Rules
    match /vibe_accounts/{accountId} {
      allow create, read, update, delete: if true;
    }

    // Vibe Conversations Rules
    match /vibe_conversations/{conversationId} {
      allow create, read, update, delete: if true;
    }

    // Vibe Messages Rules
    match /vibe_messages/{messageId} {
      allow create, read, update, delete: if true;
    }

    // Vibe Rules
    match /vibe_rules/{ruleId} {
      allow create, read, update, delete: if true;
    }

    // Vibe Brand Profiles Rules
    match /vibe_brand_profiles/{userId} {
      allow create, read, update, delete: if true;
    }

    // Vibe Settings Rules
    match /vibe_settings/{userId} {
      allow create, read, update, delete: if true;
    }

    // Vibe Audit Logs Rules
    match /vibe_audit_logs/{logId} {
      allow create, read, update, delete: if true;
    }

    // Vibe Notifications Rules
    match /vibe_notifications/{notificationId} {
      allow create, read, update, delete: if true;
    }

    // Backlink Auto-Detect Scans
    match /backlink_scans/{scanId} {
      allow create, read, update, delete: if true;
    }

    // Real-Time Affiliate Link Converter Vault
    match /affiliate_links/{linkId} {
      allow create, read, update, delete: if true;
    }

    // Lead Form Submissions (PII-protected reads, validated creates, immutable-PII Auto-Gemini updates)
    match /leads/{leadId} {
      allow create: if isValidLeadId(leadId) && isValidLeadCreate(request.resource.data);
      allow get: if isLeadsAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if isLeadsAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isValidLeadAiUpdate() && (
        isLeadsAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid)
        || (!('aiStatus' in resource.data) || resource.data.aiStatus in ['pending', 'error'])
      );
      allow delete: if isLeadsAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Global App & Tools On/Off Settings (Public read, Admin-only write)
    match /app_settings/{settingId} {
      allow get: if isValidLeadId(settingId);
      allow list: if isAuthenticated();
      allow create, update: if isValidLeadId(settingId) && isLeadsAdmin() && isValidToolConfig(request.resource.data);
      allow delete: if isLeadsAdmin();
    }

    // Memory-Ready Gemini Agent Chat Sessions (Owner-only strict reads & validated writes)
    match /chat_sessions/{sessionId} {
      allow create: if isAuthenticated()
        && isValidLeadId(sessionId)
        && isValidChatSession(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow get: if isAuthenticated() && isValidLeadId(sessionId) && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && isValidLeadId(sessionId)
        && resource.data.userId == request.auth.uid
        && isValidChatSession(request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'messages', 'updatedAt']);
      allow delete: if isAuthenticated() && isValidLeadId(sessionId) && resource.data.userId == request.auth.uid;
    }

    // Studio User Quota Profiles (users/{userId})
    match /users/{userId} {
      allow get: if isLeadsAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow list: if isLeadsAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidStudioUserCreate(userId, request.resource.data);
      allow update: if isLeadsAdmin() || (isAuthenticated() && request.auth.uid == userId && isValidStudioUserSelfUpdate(userId));
      allow delete: if isLeadsAdmin();
    }

    // Search & Auto-Collect Research Vault (collected_research_data/{recordId})
    match /collected_research_data/{recordId} {
      allow create: if isAuthenticated() && isValidLeadId(recordId) && isValidCollectedResearch(request.resource.data);
      allow get, list: if isLeadsAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if false;
      allow delete: if isLeadsAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Agent Evolver Execution Logs (super_ai_toolbox_runs/{runId})
    match /super_ai_toolbox_runs/{runId} {
      allow create: if isAuthenticated() && isValidLeadId(runId) && isValidToolboxRun(request.resource.data);
      allow get, list: if isLeadsAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if false;
      allow delete: if isLeadsAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Pakistan Local Payments TID Verification (local_payments/{paymentId})
    match /local_payments/{paymentId} {
      allow create: if isAuthenticated() && isValidLeadId(paymentId) && isValidLocalPaymentCreate(request.resource.data);
      allow get, list: if isLeadsAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isLeadsAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'updatedAt'])
        && request.resource.data.status in ['APPROVED', 'REJECTED'];
      allow delete: if isLeadsAdmin();
    }

    // Idempotent Stripe Events Ledger (stripe_events/{eventId})
    match /stripe_events/{eventId} {
      allow get, list: if isLeadsAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isLeadsAdmin();
    }
  }
}

}

// 2. LANGUAGE MODEL BOT: Same chat UI, smarter engine
const history = []; // Stores the conversation across turns

async function getLLMReply(userText, systemPrompt) {
  // Add the new user message to conversation history
  history.push({ role: "user", content: userText });

  try {
    // Send system rules + full history to the model API
    const response = await fetch("https://api.example.com/v1/chat/completions", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": "Bearer YOUR_API_KEY" // Keep secret on a server!
      },
      body: JSON.stringify({
        model: "gpt-4o-mini", // Or gemini-2.5-flash
        temperature: 0.7,     // Higher = more creative (and more risk of making things up)
        messages: [
          { role: "system", content: systemPrompt }, // Sets persona & rules
          ...history                                 // Carries context across turns
        ]
      })
    });

    const data = await response.json();
    const reply = data.choices[0].message.content;

    // Save the AI's reply so the NEXT turn remembers it
    history.push({ role: "assistant", content: reply });
    return reply;
  } catch (err) {
    return "Could not reach the model API: " + err.message;
  }
}`;


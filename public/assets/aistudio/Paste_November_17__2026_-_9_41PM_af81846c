    function handleUserMessage(text) {
      const trimmed = text.trim();
      if (!trimmed) return;

      // 1. Add user message to history
      conversationHistory.push({ role: "user", content: trimmed });

      // 2. Pick the active engine
      let replyText = "";
      if (currentMode === "rule") {
        const result = getRuleBasedReply(trimmed);
        replyText = result.reply;
        ruleMatchStatus.innerHTML = result.matchedKeyword
          ? `Matched keyword: <span class="text-cyan-300 font-mono">"${escapeHtml(result.matchedKeyword)}"</span>`
          : `<span class="text-amber-300">No keyword matched</span> → used fallback reply.`;
      } else {
        const sysPrompt = systemPromptInput.value.trim();
        replyText = getSimulatedLLMReply(conversationHistory, sysPrompt);
      }

      // 3. Add bot reply to history
      conversationHistory.push({ role: "assistant", content: replyText });

      // 4. Re-render UI
      renderMessages();
      updateLLMInspector();
    }

    // Event Listeners
    btnRule.addEventListener("click", () => setMode("rule"));
    btnLlm.addEventListener("click", () => setMode("llm"));

    document.getElementById("btn-clear-chat").addEventListener("click", () => {
      conversationHistory = [];
      ruleMatchStatus.textContent = "Send a message to see which keyword rule triggers.";
      renderMessages();
      updateLLMInspector();
    });

    chatForm.addEventListener("submit", (e) => {
      e.preventDefault();
      handleUserMessage(chatInput.value);
      chatInput.value = "";
    });

    document.querySelectorAll(".quick-prompt").forEach((btn) => {
      btn.addEventListener("click", () => {
        handleUserMessage(btn.dataset.prompt);
      });
    });

    systemPromptInput.addEventListener("input", updateLLMInspector);

    function switchRightTab(active) {
      const tabs = [
        { key: "inspector", btn: tabBtnInspector, panel: tabInspector },
        { key: "code", btn: tabBtnCode, panel: tabCode },
        { key: "studio", btn: tabBtnStudio, panel: tabStudio }
      ];
      tabs.forEach((t) => {
        if (t.key === active) {
          t.panel.classList.remove("hidden");
          t.btn.className = "flex-1 py-2.5 text-xs font-medium border-b-2 border-cyan-400 text-cyan-300";
        } else {
          t.panel.classList.add("hidden");
          t.btn.className = "flex-1 py-2.5 text-xs font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200";
        }
      });
    }

    tabBtnInspector.addEventListener("click", () => switchRightTab("inspector"));
    tabBtnCode.addEventListener("click", () => switchRightTab("code"));
    tabBtnStudio.addEventListener("click", () => switchRightTab("studio"));

    function wireCopyButton(btnId, getText) {
      const btn = document.getElementById(btnId);
      btn.addEventListener("click", () => {
        const text = getText();
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).catch(() => fallbackCopy(text));
        } else {
          fallbackCopy(text);
        }
        const orig = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => { btn.textContent = orig; }, 1500);
      });
    }

    wireCopyButton("btn-copy-firebase", () => FIREBASE_CONFIG_TEXT);
    wireCopyButton("btn-copy-env", () => ENV_TEXT);

    document.getElementById("btn-copy-code").addEventListener("click", () => {
      const btn = document.getElementById("btn-copy-code");
      const text = EDUCATIONAL_CODE;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).catch(() => fallbackCopy(text));
      } else {
        fallbackCopy(text);
      }
      btn.textContent = "Copied!";
      setTimeout(() => { btn.textContent = "Copy Code"; }, 1500);
    });

    function fallbackCopy(text) {
      const ta = document.createElement("textarea");
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
    }

    // Initial render
    codeSnippetEl.textContent = EDUCATIONAL_CODE;
    document.getElementById("firebase-config-snippet").textContent = FIREBASE_CONFIG_TEXT;
    document.getElementById("env-snippet").textContent = ENV_TEXT;
    renderRulesList();
    renderMessages();
    updateLLMInspector();
  </script>
